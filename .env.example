# 复制为 .env 用于本地运行；GitHub Actions 里把同名变量配置到仓库 Secrets

# AI 写内容 + 判断是不是游戏词（默认 DeepSeek；任何 OpenAI 兼容接口都可以）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# 可选：serper.dev 的 key，用来查谷歌第一页竞争情况；不填就跳过竞争检查
SERPER_API_KEY=

# 可选：YouTube cookies.txt 的完整内容（Netscape 格式）。不配的话 YouTube 会拦截字幕抓取，
# 内容只会基于 Steam / Roblox / 维基百科 / 新闻标题生成
YOUTUBE_COOKIES=

# 可选：YouTube Data API v3 的 key（Google Cloud 控制台免费创建），用来搜视频并读取视频简介
YOUTUBE_API_KEY=

# 可选：IndexNow key（任意 32 位字母数字），用于新站上线后通知 Bing/Yandex 收录
INDEXNOW_KEY=
