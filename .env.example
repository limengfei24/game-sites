# 复制为 .env 用于本地运行；GitHub Actions 里把同名变量配置到仓库 Secrets

# AI 写内容 + 判断是不是游戏词（默认用阿里云百炼的通义千问，OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 阿里云 RAM 子账号 AccessKey（只需要 AliyunDNSFullAccess 权限）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# 可选：serper.dev 的 key，用来查谷歌第一页竞争情况；不填就跳过竞争检查
SERPER_API_KEY=

# 可选：YouTube cookies.txt 的完整内容（Netscape 格式）。不配的话 YouTube 会拦截字幕抓取，
# 内容只会基于 Steam / Roblox / 维基百科 / 新闻标题生成
YOUTUBE_COOKIES=

# 可选：IndexNow key（任意 32 位字母数字），用于新站上线后通知 Bing/Yandex 收录
INDEXNOW_KEY=
